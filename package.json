{
  "name": "intercept",
  "version": "1.0.0",
  "description": "Network traffic interceptor with HTTPS support",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "audit:check": "node scripts/audit-check.js"
  },
  "keywords": [
    "proxy",
    "network",
    "interceptor",
    "https",
    "debugging"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "node-forge": "^1.3.1",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "proxy-server.js",
      "server.js"
    ]
  }
}
